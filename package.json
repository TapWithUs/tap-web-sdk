{
  "name": "@tapwithus/tapsdk",
  "version": "0.9.0",
  "description": "Web Bluetooth SDK for Tap Strap, TapXR, and TapBand (same BLE API; TapBand coming soon). Chrome or Edge; HTTPS or localhost.",
  "author": "Tap With Us",
  "license": "MIT",
  "homepage": "https://github.com/TapWithUs/tap-web-sdk#readme",
  "bugs": {
    "url": "https://github.com/TapWithUs/tap-web-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TapWithUs/tap-web-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --format=esm --outfile=dist/tap-web-sdk.bundle.js --sourcemap",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "keywords": [
    "tap",
    "tapstrap",
    "tapxr",
    "tapband",
    "gestures",
    "bluetooth",
    "web-bluetooth",
    "ble"
  ],
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.21",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
